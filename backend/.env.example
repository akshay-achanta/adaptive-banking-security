# SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/123456789012/adaptive-banking-workflows
# SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:123456789012:adaptive-banking-security-alerts

# Amazon Cognito configuration
