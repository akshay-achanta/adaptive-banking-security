# Server configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://d2skoyxe57scxh.cloudfront.net

# Database configuration
# When USE_MOCK_DB=true, in-memory repository is used (ideal for local testing before DynamoDB provisioning)
# When USE_MOCK_DB=false, connects to Amazon DynamoDB using IAM task role or AWS credentials
USE_MOCK_DB=true
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_NAME=AdaptiveBankingTransactions
DYNAMODB_POLICIES_TABLE=AdaptiveBankingSecurityPolicies
DYNAMODB_VERIFICATIONS_TABLE=AdaptiveBankingVerifications
DYNAMODB_SCHEDULED_TABLE=AdaptiveBankingScheduled
DYNAMODB_NOTIFICATIONS_TABLE=AdaptiveBankingNotifications
DYNAMODB_AUDIT_TABLE=AdaptiveBankingAuditLogs
# DYNAMODB_ENDPOINT_URL=http://localhost:8000 # Optional DynamoDB Local

